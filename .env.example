# Chave da API do Gemini (enviada separadamente pela Prohall). Nunca commitar o .env.
GEMINI_API_KEY=

# Único modelo liberado para o teste. Obrigatório: o código não tem modelo padrão.
GEMINI_MODEL=gemini-3.8-flash

# Opcionais: sem valor, valem os padrões do próprio modelo.
# Temperatura baixa: a Sofia é simpática, mas exata (de 0 a 2).
GEMINI_TEMPERATURE=0.3
# Quanto o modelo pensa antes de responder: MINIMAL, LOW, MEDIUM ou HIGH. Menos pensamento, resposta mais rápida.
GEMINI_THINKING_LEVEL=LOW

# Porta do servidor Fastify
PORT=3000
