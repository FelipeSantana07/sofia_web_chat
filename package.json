{
  "name": "sofia-web-chat",
  "private": true,
  "description": "Sofia Web Chat — vendedora IA Prohall",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "gemini:teste": "pnpm --filter @sofia/server gemini:teste",
    "gemini:ferramentas": "pnpm --filter @sofia/server gemini:ferramentas",
    "validate:catalogo": "pnpm --filter @sofia/server validate:catalogo",
    "chat": "pnpm --filter @sofia/server chat"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
